{
  "name": "league-skin-selector",
  "version": "1.9.0",
  "type": "commonjs",
  "description": "League of Legends skin selector using LCU API",
  "main": "dist/main/electron-main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc",
    "build:renderer": "node scripts/build-renderer.js",
    "start": "node dist/main/index.js",
    "dev": "concurrently -n renderer,server -c cyan,green \"node scripts/build-renderer.js --watch\" \"tsx watch src/main/index.ts\"",
    "dev:electron": "npm run build && concurrently -n renderer,tsc,electron -c cyan,yellow,blue \"node scripts/build-renderer.js --watch\" \"tsc --watch --preserveWatchOutput\" \"nodemon --config scripts/nodemon.electron.json\"",
    "electron": "npm run build && electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "release-it",
    "release:patch": "release-it patch --ci",
    "release:minor": "release-it minor --ci",
    "release:major": "release-it major --ci",
    "release:dry": "release-it --dry-run",
    "prepare": "husky"
  },
  "keywords": [
    "league of legends",
    "lcu",
    "skin selector"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.6.2"
  },
  "dependencies": {
    "@hasagi/core": "^0.6.9",
    "axios": "^1.13.5",
    "electron-updater": "^6.7.3",
    "express": "^5.0.0",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@release-it/conventional-changelog": "^10.0.5",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "auto-changelog": "^2.5.0",
    "concurrently": "^9.2.1",
    "electron": "^40.8.4",
    "electron-builder": "^26.4.0",
    "esbuild": "^0.27.2",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "htmlhint": "^1.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.14",
    "release-it": "^19.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0"
  },
  "overrides": {
    "rimraf": "6.1.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --fix",
    "*.html": "htmlhint"
  },
  "build": {
    "appId": "com.league.skinselector",
    "productName": "League Skin Selector",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "tg-tjmitchell",
      "repo": "skin-selector",
      "private": false
    }
  }
}
